<?xml version="1.0" encoding="utf-8" ?>
<nlog throwExceptions="true" xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogFile="D:/nlog.txt"
      internalLogToConsole="true"
      internalLogLevel="Info"
      autoReload="true">

  <!-- 
  See http://nlog-project.org/wiki/Configuration_file 
  for information on customizing logging rules and outputs.
   -->
  <targets>
    <target xsi:type="File" name="mertexerV2TraceTarget"
            fileName="D:/MertexerV2Logs/Trace/${date:format=yyyy}/${date:format=MMMM}/Trace_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2Logs/Archives/${date:format=yyyy}/${date:format=MM}/Trace_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2DebugTarget"
            fileName="D:/MertexerV2Logs/Debug/${date:format=yyyy}/${date:format=MMMM}/Debug_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2Logs/Archives/${date:format=yyyy}/${date:format=MM}/Debug_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2InfoTarget"
            fileName="D:/MertexerV2Logs/Info/${date:format=yyyy}/${date:format=MMMM}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2Logs/Archives/${date:format=yyyy}/${date:format=MM}/Info_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2WarnTarget"
            fileName="D:/MertexerV2Logs/Warnings/${date:format=yyyy}/${date:format=MMMM}/Warnings_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2Logs/Archives/${date:format=yyyy}/${date:format=MM}/Warnings_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2ErrorTarget"
            fileName="D:/MertexerV2Logs/Errors/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2Logs/Archives/${date:format=yyyy}/${date:format=MM}/Errors_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2FatalTarget"
            fileName="D:/MertexerV2Logs/Fatal/${date:format=yyyy}/${date:format=MMMM}/Fatal_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2Logs/Archives/${date:format=yyyy}/${date:format=MM}/Fatal_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>

    <target xsi:type="File" name="mertexerV2OrderStatusTraceTarget"
            fileName="D:/MertexerV2OrderStatusLogs/Trace/${date:format=yyyy}/${date:format=MMMM}/Trace_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2OrderStatusLogs/Archives/${date:format=yyyy}/${date:format=MM}/Trace_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2OrderStatusDebugTarget"
            fileName="D:/MertexerV2OrderStatusLogs/Debug/${date:format=yyyy}/${date:format=MMMM}/Debug_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2OrderStatusLogs/Archives/${date:format=yyyy}/${date:format=MM}/Debug_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2OrderStatusInfoTarget"
            fileName="D:/MertexerV2OrderStatusLogs/Info/${date:format=yyyy}/${date:format=MMMM}/Info_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2OrderStatusLogs/Archives/${date:format=yyyy}/${date:format=MM}/Info_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2OrderStatusWarnTarget"
            fileName="D:/MertexerV2OrderStatusLogs/Warnings/${date:format=yyyy}/${date:format=MMMM}/Warnings_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2OrderStatusLogs/Archives/${date:format=yyyy}/${date:format=MM}/Warnings_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2OrderStatusErrorTarget"
            fileName="D:/MertexerV2OrderStatusLogs/Errors/${date:format=yyyy}/${date:format=MMMM}/Errors_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2OrderStatusLogs/Archives/${date:format=yyyy}/${date:format=MM}/Errors_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>
    <target xsi:type="File" name="mertexerV2OrderStatusFatalTarget"
            fileName="D:/MertexerV2OrderStatusLogs/Fatal/${date:format=yyyy}/${date:format=MMMM}/Fatal_${date:format=dd-MM-yyyy}.log"
            archiveFileName="D:/MertexerV2OrderStatusLogs/Archives/${date:format=yyyy}/${date:format=MM}/Fatal_${date:format=dd-MM-yyyy}.{####}.log"
            layout="${date:format=dd-MM-yyyy} ${time:format=HH:mm:ss}      ${message}${newline}${onexception:${exception:format=tostring}}"
            archiveAboveSize="1000000"
            createDirs="true"/>


    <target name="StockRecordDiscarded" xsi:type="Mail"
      smtpServer="smtp.office365.com"
      smtpPort="587"
      smtpAuthentication="Basic"
      smtpUserName="portal.noreply@designersguild.com"
      smtpPassword="TheCakeIsALi3"
      enableSsl="true"
      from="portal.noreply@designersguild.com"
      to="tclark@designersguild.com"
      cc="mchristie@designersguild.com"
      subject="MertexerV2 Stock Record(s) Discarded"
      body="${date:format=dd-MM-yyyy} ${time:format=HH:mm:s}      ${message}${newline}${onexception:${exception:format=tostring:innerFormat=tostring:maxInnerExceptionLevel=10:innerExceptionSeparator=\r\n:separator=\r\n}}"
    />
  </targets>

  <rules>
    <logger name="MertexerV2" level="Trace" writeTo="mertexerV2TraceTarget" />
    <!--<logger name="MertexerV2" level="Debug" writeTo="mertexerV2DebugTarget" />-->
    <logger name="MertexerV2" level="Info" writeTo="mertexerV2InfoTarget" />
    <logger name="MertexerV2" level="Warn" writeTo="mertexerV2WarnTarget" />
    <logger name="MertexerV2" level="Error" writeTo="mertexerV2ErrorTarget" />
    <logger name="MertexerV2" level="Fatal" writeTo="mertexerV2FatalTarget" />

    <!--<logger name="MertexerV2OrderStatus" level="Trace" writeTo="mertexerV2OrderStatusTraceTarget" />
    --><!--<logger name="MertexerV2" level="Debug" writeTo="mertexerV2OrderStatusDebugTarget" />--><!--
    <logger name="MertexerV2OrderStatus" level="Info" writeTo="mertexerV2OrderStatusInfoTarget" />
    <logger name="MertexerV2OrderStatus" level="Warn" writeTo="mertexerV2OrderStatusWarnTarget" />
    <logger name="MertexerV2OrderStatus" level="Error" writeTo="mertexerV2OrderStatusErrorTarget" />
    <logger name="MertexerV2OrderStatus" level="Fatal" writeTo="mertexerV2OrderStatusFatalTarget" />-->

  </rules>
</nlog>