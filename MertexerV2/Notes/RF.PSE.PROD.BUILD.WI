0036          *                                                                 
0037          LOOP WHILE FILTER.CNT <= FILTER.MAX                               
0038             FILTER = FILTERS<FILTER.CNT>                                   
0039             *                                                              
0040             IF FILTER[1,4] = "MSL=" THEN                                   
0041                MINSTOCKLEN = FILTER[5,9999]                                
0042                MINSTOCKLEN = MINSTOCKLEN * 1000                            
0043                FILTER.CNT = FILTER.MAX                                       
0044             END                                                            
0045             FILTER.CNT = FILTER.CNT + 1                                    
0046          REPEAT                                                            
0047          *                                                                 
0048       END                                                                  
